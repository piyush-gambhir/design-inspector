{
  "name": "design-inspector",
  "description": "Hover over anything on a website and read its typography, colors, spacing, assets, and stack. Save references with context.",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "author": "Piyush Gambhir",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/piyush-gambhir/design-inspector"
  },
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "vitest run && tsc --noEmit && wxt build",
    "test:e2e": "DI_E2E=1 wxt build && playwright test",
    "build:firefox": "wxt build -b firefox",
    "perf": "node scripts/perf-profile.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "release": "node scripts/release.mjs",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.2.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wxt": "^0.20.27"
  },
  "dependencies": {
    "brotli": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "idb": "^8.0.4",
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0"
  }
}
